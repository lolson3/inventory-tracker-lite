[Unit]
Description=Back up Inventory Tracker Lite

[Service]
Type=oneshot
User=inventory
Group=inventory
WorkingDirectory=/opt/inventory-tracker-lite
Environment=DATA_DIR=/var/lib/inventory-tracker
ExecStart=/usr/bin/node /opt/inventory-tracker-lite/dist/cli/backup.js
UMask=0077
StateDirectory=inventory-tracker
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
